# webchat 本地开发配置
# 复制为 .env.local 填入实际值

# oc-gateway API (用于会话 CRUD、teams、container-status 等管理 API)
VITE_GATEWAY_URL=https://jacoapi.jingao.club

# 用户 auth token (从 DB auth_sessions 获取)
VITE_AUTH_TOKEN=

# OpenClaw 容器 token (从 DB containers.container_token 获取)
VITE_OPENCLAW_TOKEN=

# OpenClaw 容器 WS 端口 (从 DB containers.host_port 获取)
VITE_OPENCLAW_WS_PORT=0

# 用户名 (显示用)
VITE_USER_NAME=dev
