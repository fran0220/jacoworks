{
  "name": "@jacoworks/vm-agent",
  "version": "0.1.0",
  "private": true,
  "description": "JAcoworks per-VM agent service — Pi SDK + HTTP bridge",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:server": "MODE=server bun --watch src/server.ts",
    "start": "bun dist/index.js",
    "server": "bun src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/lib/__tests__/",
    "test:e2e": "bun test src/__tests__/rpc.test.ts --timeout 30000",
    "test:extensions": "bun test src/__tests__/extensions.e2e.test.ts --timeout 120000",
    "test:gateway-e2e": "bun test src/__tests__/gateway-api.e2e.test.ts --timeout 60000",
    "test:edge-cases": "bun test src/__tests__/edge-cases.e2e.test.ts --timeout 120000",
    "test:workspace": "bun test src/__tests__/workspace.e2e.test.ts --timeout 120000",
    "test:journeys": "bun test src/__tests__/journeys.e2e.test.ts --timeout 120000",
    "test:all": "bun test --timeout 120000",
    "compile": "bun build --compile src/index.ts --outfile dist/vm-agent",
    "compile:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/vm-agent-x86_64-unknown-linux-gnu",
    "compile:server:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/server.ts --outfile dist/vm-agent-server-aarch64-unknown-linux-gnu",
    "compile:all": "npm run compile:linux-x64 && npm run compile:server:linux-arm64"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.56.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sinclair/typebox": "^0.34.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dayjs": "^1.11.19",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.4.1",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "marked": "^17.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
