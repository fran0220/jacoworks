# JAcoworks VM Agent — 环境变量模板
# 复制为 .env 并填入实际值

# === LLM 中转 ===
LLM_PROXY_URL=http://67.230.182.59:8317
LLM_PROXY_KEY=your-proxy-key-here

# === 服务端口 (与 OpenClaw 保持一致，Go 网关无需改动) ===
PORT=18789

# === Gateway Token (Go 网关 Bearer 认证) ===
GATEWAY_TOKEN=your-gateway-token-here

# === Agent 工作目录 ===
WORKSPACE_DIR=/home/agent/workspace

# === Web Search (Exa) ===
EXA_API_KEY=your-exa-api-key-here

# === 记忆存储根目录（可选）===
# 不配置时按系统自动选择用户级应用数据目录：
# macOS: ~/Library/Application Support/JAcoworks/memory
# Windows: %LOCALAPPDATA%\JAcoworks\memory
# Linux: ~/.local/share/JAcoworks/memory
# MEMORY_ROOT_DIR=/path/to/custom/memory

# === 主模型 ===
PRIMARY_MODEL=glm-5
PRIMARY_PROVIDER=proxy-glm
