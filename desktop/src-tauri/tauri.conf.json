{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JAcoworks",
  "version": "0.1.5",
  "identifier": "com.jacoworks.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JAcoworks AI",
        "width": 1200,
        "height": 800,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**", "$PICTURE/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vm-agent"
    ],
    "resources": {
      "resources/pi-meta/package.json": "resources/pi-meta/package.json",
      "resources/skills.tar.gz": "resources/skills.tar.gz"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["jacoworks"]
      }
    },
    "updater": {
      "endpoints": [
        "https://jaco.jingao.club/api/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3QzVGODQ5ODYwMkEyRjMKUldUem9nS0dTZmpGUi9kaDRzMGR4TmdKZXBITWNieCszTXZiYnlQT29kTWdoT0MrZ2s3Wms1K0YK"
    }
  }
}
