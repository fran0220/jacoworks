{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JAcoworks",
  "version": "1.9.6",
  "identifier": "com.jacoworks.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JAcoworks AI",
        "width": 1200,
        "height": 800,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**", "$PICTURE/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/vm-agent"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/fonts/NotoSansSC-Regular.otf": "resources/fonts/NotoSansSC-Regular.otf",
      "resources/doc-packages.tar.gz": "resources/doc-packages.tar.gz",
      "resources/pi-meta": "resources/pi-meta",
      "../../vm-agent/skills": "resources/skills",
      "resources/tools": "resources/tools",
      "resources/runtimes": "resources/runtimes"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://jaco.jingao.club/api/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3RTY1RDc0OTQzOTdFNTcKUldSWGZqbVVkRjNtQi9NYzhwbGpQZHd6TTBUbE01dlJYUURiWWo1VEVzNjZRNjlzNXdtN053MlMK"
    }
  }
}
