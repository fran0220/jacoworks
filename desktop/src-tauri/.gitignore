# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (built by bun compile, not committed)
/binaries/vm-agent-*

# Skills archive built from vm-agent at build time
/resources/skills.tar.gz

# Windows runtime dependencies (populated by prepare-win-deps.sh)
/resources/runtimes/bash/*
/resources/runtimes/python/*
/resources/runtimes/node/*
!/resources/runtimes/bash/.gitkeep
!/resources/runtimes/python/.gitkeep
!/resources/runtimes/node/.gitkeep
