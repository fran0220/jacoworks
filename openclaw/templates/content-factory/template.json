{
  "name": "content-factory",
  "displayName": "内容工厂",
  "description": "4 人内容生产团队：主编统筹选题与审稿，调研员扫描全网热点，写手将调研转化为成稿，设计师构思配图。灵感来自社区 Multi-Agent Content Factory 模式。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "editor",
      "name": "主编",
      "role": "lead",
      "prompt": "prompts/editor.md",
      "skills": ["editor-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": true,
      "cron": [
        {
          "schedule": { "kind": "cron", "expression": "0 8 * * *" },
          "sessionTarget": "isolated",
          "message": "晨间选题会：读调研员昨日热点 → 更新 TOPICS.md 选题优先级 → 更新 CALENDAR.md 今日排期"
        },
        {
          "schedule": { "kind": "cron", "expression": "0 20 * * *" },
          "sessionTarget": "isolated",
          "message": "晚间审稿：读写手和设计师产出 → 审阅质量 → 标记可发布内容到 content/{date}/"
        }
      ]
    },
    {
      "id": "researcher",
      "name": "调研员",
      "role": "researcher",
      "prompt": "prompts/researcher.md",
      "skills": ["researcher-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 10800000 },
        "sessionTarget": "isolated",
        "message": "热点扫描：web_search Reddit/X/HN/微信公众号趋势 → 写入 agents/researcher/output/trends.md → 更新 notes.md"
      }
    },
    {
      "id": "writer",
      "name": "写手",
      "role": "writer",
      "prompt": "prompts/writer.md",
      "skills": ["writer-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 14400000 },
        "sessionTarget": "isolated",
        "message": "读 TOPICS.md 当前选题 → 读 agents/researcher/output/ 调研素材 → 写稿到 agents/writer/output/ → 更新 notes.md"
      }
    },
    {
      "id": "designer",
      "name": "设计师",
      "role": "designer",
      "prompt": "prompts/designer.md",
      "skills": ["designer-skill"],
      "model": "proxy/gemini-3.1-flash-image-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 14400000 },
        "sessionTarget": "isolated",
        "message": "读 agents/writer/output/ 最新成稿 → 构思配图描述和布局建议 → 写入 agents/designer/output/ → 更新 notes.md"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/content-factory",
    "files": {
      "TOPICS.md": "workspace/TOPICS.md",
      "CALENDAR.md": "workspace/CALENDAR.md",
      "STYLE_GUIDE.md": "workspace/STYLE_GUIDE.md",
      "AGENTS.md": "workspace/AGENTS.md"
    }
  },
  "theme": {
    "sceneKind": "newsroom",
    "title": "内容工厂",
    "icon": "🏭",
    "palette": {
      "primary": "#ec4899",
      "secondary": "#8b5cf6",
      "accent": "#f59e0b",
      "background": "#0f0a1a",
      "surface": "#1a1025"
    },
    "roles": {
      "lead": { "displayName": "主编", "color": "#ec4899", "icon": "🎬" },
      "researcher": { "displayName": "调研员", "color": "#8b5cf6", "icon": "🔍" },
      "writer": { "displayName": "写手", "color": "#f59e0b", "icon": "✍️" },
      "designer": { "displayName": "设计师", "color": "#06b6d4", "icon": "🎨" }
    },
    "agents": {
      "editor": { "displayName": "主编", "subtitle": "选题与审稿", "color": "#ec4899" },
      "researcher": { "displayName": "调研员", "subtitle": "热点猎手", "color": "#8b5cf6" },
      "writer": { "displayName": "写手", "subtitle": "内容创作", "color": "#f59e0b" },
      "designer": { "displayName": "设计师", "subtitle": "视觉创意", "color": "#06b6d4" }
    }
  }
}
