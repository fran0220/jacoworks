{
  "name": "morning-brief",
  "displayName": "每日简报",
  "description": "3 人简报团队：数据员追踪关注指标，新闻员扫描多源资讯，简报官汇编为每日定制简报。配置 INTERESTS.md 和 SOURCES.md 即可个性化。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "briefer",
      "name": "简报官",
      "role": "leader",
      "prompt": "prompts/briefer.md",
      "skills": ["briefer-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": true,
      "cron": {
        "schedule": { "kind": "daily", "time": "07:30" },
        "sessionTarget": "isolated",
        "message": "读取 agents/data-tracker/output/ 和 agents/news-scanner/output/ 的今日产出，结合 INTERESTS.md，汇编为 briefs/{date}.md"
      }
    },
    {
      "id": "news-scanner",
      "name": "新闻员",
      "role": "scanner",
      "prompt": "prompts/news-scanner.md",
      "skills": ["scanner-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "daily", "time": "07:00" },
        "sessionTarget": "isolated",
        "message": "读取 SOURCES.md 和 INTERESTS.md，用 web_search 扫描各信息源，将新闻摘要写入 agents/news-scanner/output/{date}.md"
      }
    },
    {
      "id": "data-tracker",
      "name": "数据员",
      "role": "tracker",
      "prompt": "prompts/data-tracker.md",
      "skills": ["tracker-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "daily", "time": "06:30" },
        "sessionTarget": "isolated",
        "message": "读取 WATCHLIST.md，用 web_search 拉取各项指标最新数据，将结构化数据写入 agents/data-tracker/output/{date}.md"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/{team_id}",
    "files": {
      "AGENTS.md": "workspace/AGENTS.md",
      "INTERESTS.md": "workspace/INTERESTS.md",
      "SOURCES.md": "workspace/SOURCES.md",
      "WATCHLIST.md": "workspace/WATCHLIST.md"
    }
  },
  "theme": {
    "title": "每日简报",
    "icon": "☀️",
    "palette": {
      "primary": "#f59e0b",
      "secondary": "#fb923c",
      "accent": "#fbbf24",
      "background": "#1a0f00",
      "surface": "#2a1a0a"
    },
    "agents": {
      "briefer": { "displayName": "简报官", "subtitle": "信息策展", "color": "#f59e0b" },
      "news-scanner": { "displayName": "新闻员", "subtitle": "多源扫描", "color": "#fb923c" },
      "data-tracker": { "displayName": "数据员", "subtitle": "指标追踪", "color": "#fbbf24" }
    }
  }
}
