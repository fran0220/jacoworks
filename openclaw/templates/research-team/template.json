{
  "name": "research-team",
  "displayName": "研究助手团",
  "description": "3 人研究团队：文献员扫描论文与行业报告，分析员深度解读，研究主管综合输出结构化研究报告。适合学术调研、市场研究、竞品分析。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "director",
      "name": "研究主管",
      "role": "leader",
      "prompt": "prompts/director.md",
      "skills": ["director-skill"],
      "model": "proxy/claude-opus-4-6",
      "isLeader": true,
      "cron": [
        {
          "schedule": { "kind": "daily", "time": "09:00" },
          "sessionTarget": "isolated",
          "message": "读取 RESEARCH_QUESTIONS.md，规划今日研究方向，检查 agents/scholar/output/ 和 agents/analyst/output/ 已有产出，分配关注重点到 agents/director/output/plan-{date}.md"
        },
        {
          "schedule": { "kind": "daily", "time": "18:00" },
          "sessionTarget": "isolated",
          "message": "读取今日所有 agents/scholar/output/ 和 agents/analyst/output/ 产出，综合为 reports/{date}.md，更新 FINDINGS.md 和 BIBLIOGRAPHY.md"
        }
      ]
    },
    {
      "id": "scholar",
      "name": "文献员",
      "role": "researcher",
      "prompt": "prompts/scholar.md",
      "skills": ["scholar-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 14400000 },
        "sessionTarget": "isolated",
        "message": "读取 RESEARCH_QUESTIONS.md 和 agents/director/output/ 最新计划，用 web_search 扫描 arXiv、Google Scholar、行业报告，将文献摘要写入 agents/scholar/output/{date}-{seq}.md"
      }
    },
    {
      "id": "analyst",
      "name": "分析员",
      "role": "analyst",
      "prompt": "prompts/analyst.md",
      "skills": ["analyst-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 14400000 },
        "sessionTarget": "isolated",
        "message": "读取 agents/scholar/output/ 最新文献摘要和 RESEARCH_QUESTIONS.md，深度分析后写入 agents/analyst/output/{date}-{seq}.md"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/{team_id}",
    "files": {
      "AGENTS.md": "workspace/AGENTS.md",
      "RESEARCH_QUESTIONS.md": "workspace/RESEARCH_QUESTIONS.md",
      "FINDINGS.md": "workspace/FINDINGS.md",
      "BIBLIOGRAPHY.md": "workspace/BIBLIOGRAPHY.md"
    }
  },
  "theme": {
    "title": "研究助手团",
    "icon": "🧑‍🔬",
    "palette": {
      "primary": "#10b981",
      "secondary": "#34d399",
      "accent": "#6ee7b7",
      "background": "#021a0f",
      "surface": "#0a2618"
    },
    "agents": {
      "director": { "displayName": "研究主管", "subtitle": "综合决策", "color": "#10b981" },
      "scholar": { "displayName": "文献员", "subtitle": "文献扫描", "color": "#34d399" },
      "analyst": { "displayName": "分析员", "subtitle": "深度分析", "color": "#6ee7b7" }
    }
  }
}
