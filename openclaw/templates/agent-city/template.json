{
  "name": "agent-city",
  "displayName": "数字之城 — 电竞城市 AI 团队",
  "description": "Solo Founder Team 协作模式：5 位 AI Agent 通过共享文件（GOALS.md / STATUS.md / DECISIONS.md）自主协作，无需任务管理中间件。亦城统筹全局，电竞官追踪赛事，生活官发掘周边，应援官点燃粉丝，舆情官全网嗅探——围绕北京智慧电竞赛事中心，打造 7×24 数字城市运营团队。",
  "version": "2.0.0",
  "agents": [
    {
      "id": "yicheng",
      "name": "亦城",
      "role": "lead",
      "prompt": "prompts/yicheng.md",
      "skills": ["city-lead-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": true,
      "cron": {
        "schedule": { "kind": "crontab", "crontab": "0 8,21 * * *" },
        "sessionTarget": "isolated",
        "message": "晨会/日报时间。8AM: 读取所有 agent notes → 更新 GOALS.md → 发布今日优先级。9PM: 汇总所有 output → 生成 city-daily.md → 更新 STATUS.md"
      }
    },
    {
      "id": "esports",
      "name": "电竞官",
      "role": "specialist",
      "prompt": "prompts/esports.md",
      "skills": ["city-esports-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 10800000 },
        "sessionTarget": "isolated",
        "message": "赛事扫描周期。读取 GOALS.md → 读取 agents/sentinel/output/trends.md → web_search LPL/KPL/JDG 最新赛事 → 产出分析写入 agents/esports/output/ → 更新 agents/esports/notes.md"
      }
    },
    {
      "id": "lifestyle",
      "name": "生活官",
      "role": "specialist",
      "prompt": "prompts/lifestyle.md",
      "skills": ["city-lifestyle-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "crontab", "crontab": "0 11,17 * * *" },
        "sessionTarget": "isolated",
        "message": "午餐/晚餐推荐时间。读取 GOALS.md → web_search 亦庄美食/优惠/团购 → 产出推荐写入 agents/lifestyle/output/ → 更新 agents/lifestyle/notes.md"
      }
    },
    {
      "id": "cheerleader",
      "name": "应援官",
      "role": "specialist",
      "prompt": "prompts/cheerleader.md",
      "skills": ["city-cheerleader-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 14400000 },
        "sessionTarget": "isolated",
        "message": "应援内容更新。读取 GOALS.md → 读取 agents/sentinel/output/trends.md + agents/esports/output/ → 创作应援内容 → 写入 agents/cheerleader/output/ → 更新 agents/cheerleader/notes.md"
      }
    },
    {
      "id": "sentinel",
      "name": "舆情官",
      "role": "specialist",
      "prompt": "prompts/sentinel.md",
      "skills": ["city-sentinel-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 7200000 },
        "sessionTarget": "isolated",
        "message": "全网舆情扫描。读取 GOALS.md → web_search 微博热搜/B站/电竞论坛/小红书 → 更新 agents/sentinel/output/trends.md → 重大事件写入 alerts.md → 更新 agents/sentinel/notes.md"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/agent-city",
    "files": {
      "GOALS.md": "workspace/GOALS.md",
      "STATUS.md": "workspace/STATUS.md",
      "DECISIONS.md": "workspace/DECISIONS.md",
      "AGENTS.md": "workspace/AGENTS.md"
    }
  },
  "theme": {
    "sceneKind": "esports-city",
    "title": "数字之城",
    "icon": "🏙️",
    "palette": {
      "primary": "#ff6b35",
      "secondary": "#00d4ff",
      "accent": "#ffd700",
      "background": "#0a0e1a",
      "surface": "#1a1e2e"
    },
    "roles": {
      "lead": { "displayName": "城市主理人", "color": "#ff6b35", "icon": "🏙️" },
      "specialist": { "displayName": "城务专员", "color": "#3b82f6", "icon": "⚡" }
    },
    "agents": {
      "yicheng": { "displayName": "亦城", "subtitle": "城市主理人", "color": "#ff6b35" },
      "esports": { "displayName": "电竞官", "subtitle": "赛事情报", "color": "#e74c3c" },
      "lifestyle": { "displayName": "生活官", "subtitle": "本地生活", "color": "#2ecc71" },
      "cheerleader": { "displayName": "应援官", "subtitle": "粉丝互动", "color": "#f39c12" },
      "sentinel": { "displayName": "舆情官", "subtitle": "全网嗅探", "color": "#8b5cf6" }
    },
    "zones": {
      "tower": { "label": "指挥中心", "icon": "🏙️" },
      "arena": { "label": "电竞场", "icon": "⚔️" },
      "street": { "label": "美食街", "icon": "🍜" },
      "square": { "label": "应援广场", "icon": "📢" },
      "radar": { "label": "舆情雷达", "icon": "🔍" }
    }
  }
}
