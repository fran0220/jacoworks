{
  "name": "agent-city",
  "displayName": "数字之城 — 电竞城市团队",
  "description": "以「亦城」为核心的数字城市运营团队。亦城统筹城市运营，电竞官追踪赛事，生活官发掘周边，应援官激发粉丝，督导官把控质量，巡城官维护秩序。通过 JaMOSS 持续协调，为北京智慧电竞赛事中心提供全方位数字服务。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "yicheng",
      "name": "亦城",
      "role": "planner",
      "prompt": "prompts/yicheng.md",
      "skills": ["city-planner-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": true,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 900000 },
        "sessionTarget": "isolated",
        "message": "检查城市运营状态，监控赛事与生活资讯，协调团队任务，汇总产出"
      }
    },
    {
      "id": "esports",
      "name": "电竞官",
      "role": "executor",
      "prompt": "prompts/esports.md",
      "skills": ["city-esports-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 900000 },
        "sessionTarget": "isolated",
        "message": "领取赛事任务，搜索最新赛事资讯，产出赛事内容，提交审查"
      }
    },
    {
      "id": "lifestyle",
      "name": "生活官",
      "role": "executor",
      "prompt": "prompts/lifestyle.md",
      "skills": ["city-lifestyle-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 1800000 },
        "sessionTarget": "isolated",
        "message": "领取生活任务，搜索周边优惠和美食，产出推荐内容，提交审查"
      }
    },
    {
      "id": "cheerleader",
      "name": "应援官",
      "role": "executor",
      "prompt": "prompts/cheerleader.md",
      "skills": ["city-cheerleader-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 900000 },
        "sessionTarget": "isolated",
        "message": "领取应援任务，搜索赛事舆情，产出应援内容，提交审查"
      }
    },
    {
      "id": "inspector",
      "name": "督导官",
      "role": "reviewer",
      "prompt": "prompts/inspector.md",
      "skills": ["city-reviewer-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 1800000 },
        "sessionTarget": "isolated",
        "message": "审查已提交内容，评分反馈，确保质量标准"
      }
    },
    {
      "id": "patroller",
      "name": "巡城官",
      "role": "patrol",
      "prompt": "prompts/patroller.md",
      "skills": ["city-patrol-skill"],
      "model": "proxy/gpt-5.4",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 1800000 },
        "sessionTarget": "isolated",
        "message": "巡检城市运营状态，检测超时任务，清理过期信息"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/agent-city",
    "files": {
      "AGENTS.md": "workspace/AGENTS.md",
      "RULES.md": "rules/city-rules.md"
    }
  },
  "middleware": {
    "type": "jamoss",
    "port": 6565,
    "database": "sqlite:///data/teams/agent-city/tasks.db"
  },
  "theme": {
    "sceneKind": "esports-city",
    "title": "数字之城",
    "icon": "🏙️",
    "palette": {
      "primary": "#ff6b35",
      "secondary": "#00d4ff",
      "accent": "#ffd700",
      "background": "#0a0e1a",
      "surface": "#1a1e2e"
    },
    "roles": {
      "planner": { "displayName": "城市主理人", "color": "#ff6b35", "icon": "🏙️" },
      "executor": { "displayName": "城务官", "color": "#3b82f6", "icon": "⚡" },
      "reviewer": { "displayName": "督导官", "color": "#22c55e", "icon": "🔍" },
      "patrol": { "displayName": "巡城官", "color": "#a855f7", "icon": "🛤️" }
    },
    "agents": {
      "yicheng": { "displayName": "亦城", "subtitle": "城市主理人", "color": "#ff6b35" },
      "esports": { "displayName": "电竞官", "subtitle": "赛事情报", "color": "#e74c3c" },
      "lifestyle": { "displayName": "生活官", "subtitle": "生活服务", "color": "#2ecc71" },
      "cheerleader": { "displayName": "应援官", "subtitle": "粉丝互动", "color": "#f39c12" },
      "inspector": { "displayName": "督导官", "subtitle": "质量审查", "color": "#22c55e" },
      "patroller": { "displayName": "巡城官", "subtitle": "城市巡检", "color": "#a855f7" }
    },
    "zones": {
      "tower": { "label": "指挥中心", "icon": "🏙️" },
      "forge": { "label": "工作坊", "icon": "⚡" },
      "court": { "label": "审查厅", "icon": "⚖️" },
      "lounge": { "label": "城市广场", "icon": "🏛" },
      "hub": { "label": "中央枢纽", "icon": "🎯" },
      "patrol_path": { "label": "巡城环路", "icon": "🛤️" }
    }
  }
}
