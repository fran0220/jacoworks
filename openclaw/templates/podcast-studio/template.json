{
  "name": "podcast-studio",
  "displayName": "播客工作室",
  "description": "3 人播客制作团队：制片人统筹节目规划，调研员深挖话题与嘉宾背景，文案生成节目大纲、show notes 和社交推广物料。从选题到发布全流程覆盖。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "producer",
      "name": "制片人",
      "role": "lead",
      "prompt": "prompts/producer.md",
      "skills": ["producer-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": true,
      "cron": {
        "schedule": { "kind": "cron", "expression": "0 9 * * *" },
        "sessionTarget": "isolated",
        "message": "每日晨检：阅读 EPISODE_QUEUE.md 和 SHOW_BIBLE.md，检查节目进度，推进待办选题，协调调研员和文案"
      }
    },
    {
      "id": "researcher",
      "name": "调研员",
      "role": "researcher",
      "prompt": "prompts/researcher.md",
      "skills": ["researcher-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 21600000 },
        "sessionTarget": "isolated",
        "message": "定期调研：阅读 EPISODE_QUEUE.md 找到 status=researching 的选题，深度搜索话题背景、嘉宾资料、竞品节目，产出写入 research/ 目录"
      }
    },
    {
      "id": "copywriter",
      "name": "文案",
      "role": "copywriter",
      "prompt": "prompts/copywriter.md",
      "skills": ["copywriter-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 21600000 },
        "sessionTarget": "isolated",
        "message": "定期写稿：阅读 EPISODE_QUEUE.md 找到 status=writing 的选题，基于 research/ 调研结果生成大纲、问题清单、show notes 草稿"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/podcast-studio",
    "files": {
      "SHOW_BIBLE.md": "workspace/SHOW_BIBLE.md",
      "EPISODE_QUEUE.md": "workspace/EPISODE_QUEUE.md",
      "AGENTS.md": "workspace/AGENTS.md"
    }
  },
  "theme": {
    "sceneKind": "podcast-studio",
    "title": "播客工作室",
    "icon": "🎙️",
    "palette": {
      "primary": "#8b5cf6",
      "secondary": "#a78bfa",
      "accent": "#c4b5fd",
      "background": "#0a0520",
      "surface": "#1a1030"
    },
    "roles": {
      "lead": { "displayName": "制片人", "color": "#8b5cf6", "icon": "🎙️" },
      "researcher": { "displayName": "调研员", "color": "#06b6d4", "icon": "🔍" },
      "copywriter": { "displayName": "文案", "color": "#f59e0b", "icon": "✍️" }
    },
    "agents": {
      "producer": { "displayName": "制片人", "subtitle": "节目统筹", "color": "#8b5cf6" },
      "researcher": { "displayName": "调研员", "subtitle": "话题深挖", "color": "#06b6d4" },
      "copywriter": { "displayName": "文案", "subtitle": "内容创作", "color": "#f59e0b" }
    }
  }
}
