{
  "name": "social-media",
  "displayName": "社媒运营团",
  "description": "4 人社交媒体运营团队：运营总监统筹日计划，趋势猎手全平台扫描热点，文案手多平台适配创作，互动官发掘高质量回复机会。互动官是隐藏杀手锏——比发推文更涨粉。",
  "version": "1.0.0",
  "agents": [
    {
      "id": "director",
      "name": "运营总监",
      "role": "lead",
      "prompt": "prompts/director.md",
      "skills": ["director-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": true,
      "cron": [
        {
          "schedule": { "kind": "cron", "expression": "0 9 * * *" },
          "sessionTarget": "isolated",
          "message": "早间日计划：阅读 BRAND_VOICE.md 和 CONTENT_CALENDAR.md，规划今日内容方向，协调趋势猎手和文案手"
        },
        {
          "schedule": { "kind": "cron", "expression": "0 18 * * *" },
          "sessionTarget": "isolated",
          "message": "晚间复盘：汇总今日产出，审核 CONTENT_CALENDAR.md 完成度，审核 ENGAGEMENT_QUEUE.md 互动效果，规划明日重点"
        }
      ]
    },
    {
      "id": "trend-hunter",
      "name": "趋势猎手",
      "role": "trend-hunter",
      "prompt": "prompts/trend-hunter.md",
      "skills": ["trend-skill"],
      "model": "proxy/gemini-3.1-pro-preview",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 7200000 },
        "sessionTarget": "isolated",
        "message": "全平台热点扫描：搜索 X/微博/小红书/Reddit/B站 最新趋势，更新 trends/ 目录，标记与品牌相关的热点"
      }
    },
    {
      "id": "copywriter",
      "name": "文案手",
      "role": "copywriter",
      "prompt": "prompts/copywriter.md",
      "skills": ["copy-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 10800000 },
        "sessionTarget": "isolated",
        "message": "内容创作：阅读 trends/ 最新热点和 CONTENT_CALENDAR.md 计划，为各平台撰写内容草稿，产出写入 drafts/ 目录"
      }
    },
    {
      "id": "engagement",
      "name": "互动官",
      "role": "engagement",
      "prompt": "prompts/engagement.md",
      "skills": ["engagement-skill"],
      "model": "proxy/claude-sonnet-4-6",
      "isLeader": false,
      "cron": {
        "schedule": { "kind": "every", "everyMs": 10800000 },
        "sessionTarget": "isolated",
        "message": "互动发掘：搜索与品牌领域相关的高质量对话/帖子/推文，筛选可以提供真正价值的回复机会，更新 ENGAGEMENT_QUEUE.md"
      }
    }
  ],
  "workspace": {
    "sharedRoot": "/data/teams/social-media",
    "files": {
      "BRAND_VOICE.md": "workspace/BRAND_VOICE.md",
      "CONTENT_CALENDAR.md": "workspace/CONTENT_CALENDAR.md",
      "ENGAGEMENT_QUEUE.md": "workspace/ENGAGEMENT_QUEUE.md",
      "AGENTS.md": "workspace/AGENTS.md"
    }
  },
  "theme": {
    "sceneKind": "social-media",
    "title": "社媒运营团",
    "icon": "📱",
    "palette": {
      "primary": "#06b6d4",
      "secondary": "#0ea5e9",
      "accent": "#38bdf8",
      "background": "#001a2e",
      "surface": "#0a2540"
    },
    "roles": {
      "lead": { "displayName": "运营总监", "color": "#06b6d4", "icon": "📱" },
      "trend-hunter": { "displayName": "趋势猎手", "color": "#f59e0b", "icon": "👁️" },
      "copywriter": { "displayName": "文案手", "color": "#8b5cf6", "icon": "✍️" },
      "engagement": { "displayName": "互动官", "color": "#10b981", "icon": "💬" }
    },
    "agents": {
      "director": { "displayName": "运营总监", "subtitle": "策略统筹", "color": "#06b6d4" },
      "trend-hunter": { "displayName": "趋势猎手", "subtitle": "热点扫描", "color": "#f59e0b" },
      "copywriter": { "displayName": "文案手", "subtitle": "内容创作", "color": "#8b5cf6" },
      "engagement": { "displayName": "互动官", "subtitle": "互动发掘", "color": "#10b981" }
    }
  }
}
