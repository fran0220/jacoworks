cookie_secret = "0123456789abcdef0123456789abcdef"

[server]
host = "0.0.0.0"
port = 9527
# CI 上传安装包的目录 (release-desktop.yml SCP → 此目录)
releases_dir = "/opt/jacoworks/releases"

[database]
url = "postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/jacoworks"

[gateway]
url = "http://localhost:8847"
# Public URL for browser redirects (Feishu SSO). Omit to use `url`.
public_url = "https://jacoapi.jingao.club"
admin_token = "your-admin-token"

[site]
name = "JAcoworks"
description = "企业 AI 协同办公平台"
base_url = "https://jaco.jingao.club"
