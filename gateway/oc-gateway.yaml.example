server:
  port: 18700
  host: "0.0.0.0"
  public_url: "http://localhost:18700"
  static_dir: "../website/static"

auth:
  admin_token: ""

database:
  url: "postgresql://postgres:PASSWORD@127.0.0.1:5433/jacoworks"

openclaw:
  docker_host: ""  # ignored for Incus — uses local Unix socket
  image: "pi-ready"  # Pi CLI VM image alias
  port: 18789
  host_ip: "127.0.0.1"
  base_port: 18800
  data_root: "/srv/jacoworks/openclaw"

llm:
  exa_api_key: ""
  tavily_api_key: ""
  grok_api_url: ""
  grok_api_key: ""
  grok_model: "grok-4.1-fast"
  asset_gateway_token: ""
  asset_gateway_url: "https://assets.xiaomao.chat"
