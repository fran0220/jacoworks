  docker_host: "tcp://100.94.98.106:2375"
  image: "jacoworks/vm-agent:latest"
  network: "agent-net"
  agent_port: 18789
  host_ip: "100.94.98.106"
  gateway_token: ""

openclaw:
  docker_host: "tcp://10.10.0.2:2375"
  image: "pi-ready"
  port: 18789
  host_ip: "10.10.0.2"
  base_port: 18800
  data_root: "/srv/jacoworks/openclaw"

chat_agent:
