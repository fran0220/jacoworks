[Unit]
Description=JAcoworks VM Agent (Pi SDK)
After=network.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/vm-agent
ExecStart=/usr/bin/node --enable-source-maps /home/agent/vm-agent/dist/index.js
Restart=always
RestartSec=5

# Environment
EnvironmentFile=/home/agent/vm-agent/.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/agent

[Install]
WantedBy=multi-user.target
