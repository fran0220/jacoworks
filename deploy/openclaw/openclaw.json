{
  // JAcoworks OpenClaw 配置 — Per-User VM 模板
  // 部署到容器: ~/.openclaw/openclaw.json
  // 同步命令: ./deploy/scripts/sync-openclaw.sh

  // ═══════════════════════════════════════════════════
  // 模型配置 — 4 个 Provider + 自定义模型注册
  // ═══════════════════════════════════════════════════
  models: {
    mode: "replace",
    providers: {
      // Claude (Anthropic 原生协议: POST /v1/messages)
      "proxy-claude": {
        baseUrl: "${LLM_PROXY_URL}",
        apiKey: "${LLM_PROXY_KEY}",
        api: "anthropic-messages",
        models: [
          {id: "claude-opus-4-6", name: "Claude Opus 4.6", contextWindow: 200000, maxTokens: 16384, reasoning: true, input: ["text", "image"]},
          {id: "claude-sonnet-4-6", name: "Claude Sonnet 4.6", contextWindow: 200000, maxTokens: 16384, reasoning: true, input: ["text", "image"]},
          {id: "claude-haiku-4-5-20251001", name: "Claude Haiku 4.5", contextWindow: 200000, maxTokens: 8192, input: ["text", "image"]},
        ],
      },
      // GPT (OpenAI 原生协议: POST /v1/chat/completions)
      "proxy-gpt": {
        baseUrl: "${LLM_PROXY_URL}/v1",
        apiKey: "${LLM_PROXY_KEY}",
        api: "openai-completions",
        models: [
          {id: "gpt-5.2", name: "GPT-5.2", contextWindow: 128000, maxTokens: 16384, input: ["text", "image"]},
          {id: "gpt-5.3-codex", name: "GPT-5.3 Codex", contextWindow: 128000, maxTokens: 16384, input: ["text"]},
        ],
      },
      // Gemini (OpenAI 兼容协议)
      "proxy-gemini": {
        baseUrl: "${LLM_PROXY_URL}/v1",
        apiKey: "${LLM_PROXY_KEY}",
        api: "openai-completions",
        models: [
          {id: "gemini-3-pro-preview", name: "Gemini 3 Pro", contextWindow: 1000000, maxTokens: 8192, input: ["text", "image"]},
          {id: "gemini-3-pro-image-preview", name: "Gemini 3 Pro Image", contextWindow: 1000000, maxTokens: 8192, input: ["text"]},
          {id: "gemini-3-flash-preview", name: "Gemini 3 Flash", contextWindow: 1000000, maxTokens: 8192, input: ["text", "image"]},
        ],
      },
      // Grok (OpenAI 兼容协议)
      "proxy-grok": {
        baseUrl: "${LLM_PROXY_URL}/v1",
        apiKey: "${LLM_PROXY_KEY}",
        api: "openai-completions",
        models: [
          {id: "grok-4.1-fast", name: "Grok 4.1 Fast", contextWindow: 128000, maxTokens: 8192, input: ["text"]},
          {id: "grok-imagine-1.0", name: "Grok Imagine", contextWindow: 8000, maxTokens: 8000, input: ["text"]},
        ],
      },
      // GLM (OpenAI 兼容协议)
      "proxy-glm": {
        baseUrl: "${LLM_PROXY_URL}/v1",
        apiKey: "${LLM_PROXY_KEY}",
        api: "openai-completions",
        models: [
          {id: "glm-5", name: "GLM-5", contextWindow: 128000, maxTokens: 16384, input: ["text", "image"]},
        ],
      },
    },
  },

  // ═══════════════════════════════════════════════════
  // Agent 默认配置
  // ═══════════════════════════════════════════════════
  agents: {
    defaults: {
      model: {
        primary: "proxy-glm/glm-5",
        fallbacks: [
          "proxy-gpt/gpt-5.2",
          "proxy-gemini/gemini-3-pro-preview",
        ],
      },
      imageModel: {
        primary: "proxy-gemini/gemini-3-pro-image-preview",
        fallbacks: [
          "proxy-grok/grok-imagine-1.0",
        ],
      },
      workspace: "/home/agent/.openclaw/workspace",
      bootstrapMaxChars: 20000,
      userTimezone: "Asia/Shanghai",

      // 记忆 — 在线向量搜索 (OpenAI Embedding API, 无本地回退)
      memorySearch: {
        provider: "openai",
        model: "text-embedding-3-small",
        remote: {
          apiKey: "${OPENAI_API_KEY}",
        },
        sync: {watch: true},
        cache: {enabled: true, maxEntries: 10000},
      },

      // 上下文自动压缩
      compaction: {
        reserveTokensFloor: 20000,
        memoryFlush: {enabled: true, softThresholdTokens: 4000},
      },

      timeoutSeconds: 600,

      // 心跳 (可选，按需开启)
      heartbeat: {
        every: "30m",
        activeHours: {start: "08:00", end: "22:00", timezone: "Asia/Shanghai"},
        target: "last",
      },

      // 沙箱关闭 — LXD 容器本身就是沙箱
      sandbox: {
        mode: "off",
        workspaceAccess: "rw",
        scope: "session",
      },
    },
  },

  // ═══════════════════════════════════════════════════
  // 工具设置 — 全部开启
  // ═══════════════════════════════════════════════════
  tools: {
    profile: "full",
    web: {
      search: {enabled: true},
      fetch: {enabled: true, maxCharsCap: 50000},
    },
    exec: {
      applyPatch: {enabled: true, workspaceOnly: true},
    },
    loopDetection: {enabled: true},
  },

  // ═══════════════════════════════════════════════════
  // 浏览器 — headless Chrome (容器环境)
  // ═══════════════════════════════════════════════════
  browser: {
    enabled: true,
    headless: true,
    noSandbox: true,
    defaultProfile: "openclaw",
    executablePath: "/usr/bin/google-chrome-stable",
  },

  // ═══════════════════════════════════════════════════
  // Gateway 设置
  // ═══════════════════════════════════════════════════
  gateway: {
    port: 18789,
    bind: "lan",
    mode: "local",
    controlUi: {enabled: true, dangerouslyAllowHostHeaderOriginFallback: true},
    auth: {mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}"},
    remote: {token: "${OPENCLAW_GATEWAY_TOKEN}"},
    reload: {mode: "hybrid"},
    http: {endpoints: {chatCompletions: {enabled: true}}},
  },

  // ═══════════════════════════════════════════════════
  // 技能加载
  // ═══════════════════════════════════════════════════
  skills: {
    load: {extraDirs: [], watch: true},
    entries: {peekaboo: {enabled: false}, gog: {enabled: false}},
  },

  // ═══════════════════════════════════════════════════
  // 命令
  // ═══════════════════════════════════════════════════
  commands: {native: "auto", nativeSkills: "auto"},
}
