# JAcoworks OpenClaw Per-User VM 环境变量
#
# 正常流程: 网关 provision 时自动注入 (ssh_client.go → lxc file push)
# 手动部署: 复制为 .env 填入实际值, 放到容器 ~/.openclaw/.env
#
# 两种方式写入的变量完全相同, 不是两套系统。

# LLM 中转站
LLM_PROXY_URL=http://67.230.182.59:8317
LLM_PROXY_KEY=

# OpenAI Embedding API (记忆向量搜索, 需直连 OpenAI, 中转站不支持 Embedding)
OPENAI_API_KEY=

# OpenClaw Gateway 认证 (网关 provision 时自动生成)
OPENCLAW_GATEWAY_TOKEN=
