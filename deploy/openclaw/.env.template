# JAcoworks OpenClaw Per-User VM 环境变量模板
# 克隆容器时由 Go 管理网关自动生成 .env 并注入

# ── LLM 中转平台 (所有容器共享) ──
LLM_PROXY_URL=http://67.230.171.248:8317
LLM_PROXY_KEY=__YOUR_LLM_PROXY_KEY__

# ── Gateway 认证 (每容器独立生成) ──
# Go 网关克隆时自动生成: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=__GENERATED_PER_CONTAINER__

# ── Node.js TLS (固定值) ──
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# ── 搜索 API Keys (所有容器共享) ──
EXA_API_KEY=
TAVILY_API_KEY=

# ── Brave Search (可选，OpenClaw web_search 使用) ──
# BRAVE_API_KEY=
